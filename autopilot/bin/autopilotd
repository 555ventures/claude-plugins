#!/usr/bin/env node
'use strict'
// autopilotd [--hub-config <path>] [--config <path>] [--state-dir <path>] [--check] [--hold]
// [--ready-file <path>] — the autopilot daemon entry point (specs/20260801/03-lane-engine.md D8,
// specs/20260801/04-live-smoke.md D2/D3/D5, specs/20260810/04-hub-wired-daemon.md D7/D8). Boots
// one lane per discovered project from `hub.json` (`--hub-config`, default
// ~/.config/autopilot/hub.json) merged with optional per-project overrides (`--config`, default
// ~/.config/autopilot/config.json) — `daemon/config.js`'s `loadHubConfig` owns discovery (spec
// 03) and default derivation; this file only renders its errors and exits. Wires the hub adapter
// (`daemon/hub-adapter.js`, over the hub API — the direct-Telegram adapter is deleted, D1) and
// the SDK session runner (spec 02) into each lane (spec 03), registers every discovered repo
// against the hub on every real start (D7 — "registrations refreshed"), and starts every lane's
// poll-the-oracle loop. The oracle each lane polls is a thin shell to
// `node <specPluginRoot>/scripts/spec-status.js --root <lane.root> --next --json` (D2) — this
// file's only "routing" logic is building that one child-process call; the lane itself picks
// the first admissible entry.
//
// Boot order matters (AC-20260801-03-10): the recursion guard and the Node-version floor are
// checked BEFORE hub.json is even read, so a misconfigured/missing hub.json never masks either
// precondition. Both are fatal — printed to stderr with the remedy, exit 2 — because a daemon
// that started anyway would either spawn a session inside a session (unbounded recursion, spec
// 02 D6) or `ERR_REQUIRE_ESM` when session.js lazily requires ./sdk.js for the first real stage.
//
// A real (non---check) start takes a pidfile lock in --state-dir before constructing any lane
// (specs/20260810/05-service-bootstrap.md D5) so two autopilotd processes — a tmux debug session
// left running beside the installed `Restart=always` service is the likely accident — can never
// drive the same repo at once. A live lock holder is fatal (exit 2, message names the pid and
// the remedy); a stale lock (dead pid) is recovered automatically by daemon/lock.js. The lock is
// released on clean SIGTERM/SIGINT shutdown, never on the forced double-signal exit. `--check`
// never touches the lock — preflight must be able to run beside a live daemon.
//
// --check runs an offline preflight instead of starting lanes (spec 04-live-smoke D2, carried
// forward by D8): validate hub.json + discover lanes (both fs-only, `loadHubConfig` performs no
// network I/O), force-resolve `../daemon/sdk` (session.js otherwise loads it lazily, so a bare
// boot proves nothing about a missing `autopilot/node_modules`), assert the oracle script exists
// under `specPluginRoot`, construct the adapter and every lane (construction alone performs no
// I/O), then PASS — without registering a repo, polling the hub, spawning a session, or touching
// --state-dir. --hold turns a passing preflight into a resident process that writes --ready-file
// and blocks until SIGTERM/SIGINT (spec 04-live-smoke D3) — this, not bare --check, is what the
// repo's boot leg runs, because a one-shot preflight as smoke.sh's bootCommand would red-gate
// every review.
//
// Deliberately does NOT: retry a broken hub.json/overrides file (loadHubConfig's Error already
// names the field and the remedy — this file only renders it and exits), re-derive what any lane
// should run next (that's the injected oracle + lane.js, per the v6.20.0 sole-derivation rule),
// exit non-zero because a lane failed/halted (halt/backoff are steady states a lane lives in
// forever; only a signal, a boot precondition, or a failed registration ends this process),
// create --state-dir during --check (the unconditional mkdirSync stays exclusive to the normal
// start path), or register any repo during --check (D8 — the boot leg must stay network-free).
//
// Exit codes:
//   0  preflight passed (without --hold), or normal shutdown on SIGTERM/SIGINT (every lane
//      stopped, state persisted, adapter stopped, lock released) — --hold's teardown on signal
//      also exits 0
//   1  forced exit on a second SIGTERM/SIGINT during shutdown (D8's double-kill pattern — a
//      stuck lane never wedges the process) · a real start's repo registration answered non-2xx
//      or malformed for some repo (message names the failing repo verbatim, D7 Behavior)
//   2  usage / precondition failure — recursion guard, Node version floor, bad flag, missing or
//      invalid hub.json/overrides, an unusable reposRoot, a discovery basename collision,
//      unresolvable SDK, missing oracle script (message always names the remedy), or another
//      live autopilotd already holds the pidfile lock (specs/20260810/05-service-bootstrap.md
//      D5 — message names the existing pid and the remedy)

const fs = require('fs')
const os = require('os')
const path = require('path')
const { execFile } = require('child_process')

const { loadHubConfig } = require('../daemon/config')
const { createLane } = require('../daemon/lane')
const { runStage } = require('../daemon/session')
const { createHubAdapter } = require('../daemon/hub-adapter')
const { registerRepos } = require('../daemon/discover')
const { acquireLock, releaseLock, LockError } = require('../daemon/lock')

const NODE_FLOOR = { major: 20, minor: 19 }
const DEFAULT_HUB_CONFIG_PATH = path.join(os.homedir(), '.config', 'autopilot', 'hub.json')
const DEFAULT_OVERRIDES_PATH = path.join(os.homedir(), '.config', 'autopilot', 'config.json')
const DEFAULT_STATE_DIR = path.join(os.homedir(), '.config', 'autopilot', 'state')
const USAGE =
  'usage: autopilotd [--hub-config <path>] [--config <path>] [--state-dir <path>] [--check] ' +
  '[--hold] [--ready-file <path>]'

function fail(message) {
  console.error(message)
  process.exit(2)
}

// D8: refuses before hub.json is even read — a session spawning a session recurses unbounded
// (spec 02 D6's recursion guard, checked from this side).
function assertNoRecursion() {
  if (process.env.AUTOPILOT_SESSION === '1') {
    fail(
      'autopilotd: refusing to start — AUTOPILOT_SESSION=1 is set, meaning this process is ' +
      'itself running inside a spec-pipeline session (recursion guard, spec 02 D6 / spec 03 ' +
      'D8); autopilot never launches a nested daemon from a session'
    )
  }
}

// spec 02 D11: the SDK is ESM-only; require() of ESM needs Node >=20.19.0 or session.js's
// lazy require('./sdk') throws ERR_REQUIRE_ESM on the very first real stage.
function assertNodeVersion() {
  const [major, minor] = process.versions.node.split('.').map(Number)
  const meetsFloor = major > NODE_FLOOR.major || (major === NODE_FLOOR.major && minor >= NODE_FLOOR.minor)
  if (!meetsFloor) {
    fail(
      `autopilotd: requires Node >=${NODE_FLOOR.major}.${NODE_FLOOR.minor}.0 (spec 02 D11 — ` +
      `the Claude Agent SDK is ESM-only), found ${process.versions.node} — upgrade Node`
    )
  }
}

// Hand-rolled --flag parsing (repo convention — no arg library). --check/--hold are boolean;
// the rest each require a value. --hold requires --ready-file (spec 04-live-smoke D3's
// Contracts) — checked here, at parse time, before any hub.json/config work happens.
function parseArgs(argv) {
  const args = {
    hubConfigPath: DEFAULT_HUB_CONFIG_PATH,
    overridesPath: DEFAULT_OVERRIDES_PATH,
    stateDir: DEFAULT_STATE_DIR,
    check: false,
    hold: false,
    readyFile: undefined,
  }
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (arg === '--hub-config') {
      args.hubConfigPath = argv[i + 1]
      if (!args.hubConfigPath) fail(`autopilotd: --hub-config needs a path — ${USAGE}`)
      i++
    } else if (arg === '--config') {
      args.overridesPath = argv[i + 1]
      if (!args.overridesPath) fail(`autopilotd: --config needs a path — ${USAGE}`)
      i++
    } else if (arg === '--state-dir') {
      args.stateDir = argv[i + 1]
      if (!args.stateDir) fail(`autopilotd: --state-dir needs a path — ${USAGE}`)
      i++
    } else if (arg === '--ready-file') {
      args.readyFile = argv[i + 1]
      if (!args.readyFile) fail(`autopilotd: --ready-file needs a path — ${USAGE}`)
      i++
    } else if (arg === '--check') {
      args.check = true
    } else if (arg === '--hold') {
      args.hold = true
    }
  }
  if (args.hold && !args.readyFile) {
    fail(`autopilotd: --hold needs --ready-file <path> — ${USAGE}`)
  }
  return args
}

// D2: the oracle is a thin shell to spec-status.js --next --json for one lane's root; a
// non-zero exit or unparseable stdout rejects, which lane.js's mainLoop treats as `backoff`
// (never a crash) and narrates 🚫 once (AC-20260801-03-13).
function buildOracle(specPluginRoot, root) {
  const scriptPath = path.join(specPluginRoot, 'scripts', 'spec-status.js')
  return function oracle() {
    return new Promise((resolve, reject) => {
      execFile(
        process.execPath,
        [scriptPath, '--root', root, '--next', '--json'],
        { maxBuffer: 10 * 1024 * 1024 },
        (err, stdout, stderr) => {
          if (err) {
            reject(new Error(`spec-status.js exited non-zero for ${root} — ${(stderr || err.message).trim()}`))
            return
          }
          try {
            resolve(JSON.parse(stdout))
          } catch (parseErr) {
            reject(new Error(`spec-status.js printed unparseable JSON for ${root} — ${parseErr.message}`))
          }
        }
      )
    })
  }
}

function makeLog(project) {
  return (message) => console.error(`autopilotd[${project}]: ${message}`)
}

// Shared by both --check's lane construction and the normal start path (Behavior: load+validate
// hub.json+overrides → require sdk → assert oracle script → construct adapter → construct every
// lane). Construction alone performs no I/O — only adapter.start()/lane.start() do.
function buildAdapterAndLanes(cfg, stateDir) {
  const adapter = createHubAdapter({ credential: cfg.credential, stateDir })

  const lanes = cfg.lanes.map((laneCfg) =>
    createLane({
      // pluginPaths is host-level (D7); lane.js reads it off its own `cfg` (Contracts), so it's
      // merged onto the per-lane row here rather than threaded as a separate param.
      cfg: { ...laneCfg, pluginPaths: cfg.pluginPaths },
      adapter,
      runStage,
      oracle: buildOracle(cfg.specPluginRoot, laneCfg.root),
      stateDir,
      log: makeLog(laneCfg.project),
    })
  )

  return { adapter, lanes }
}

// D8: the offline preflight. Forces the real SDK require, asserts the oracle script exists,
// constructs the adapter and every lane, then PASSes — never registering a repo, polling the
// hub, spawning a session, or writing under --state-dir. --hold (validated at parse time to
// carry --ready-file) turns a PASS into a resident process for smoke.sh's boot leg instead of
// exiting, so a killed hold never leaves state behind either.
function runPreflight(cfg, args) {
  try {
    require('../daemon/sdk')
  } catch (err) {
    fail(`autopilotd: cannot resolve the Claude Agent SDK (${err.message}) — run: cd autopilot && npm install`)
    return
  }

  const scriptPath = path.join(cfg.specPluginRoot, 'scripts', 'spec-status.js')
  if (!fs.existsSync(scriptPath)) {
    fail(
      `autopilotd: no oracle script at ${scriptPath} — check the reposRoot/specPluginRoot ` +
      `resolved from --hub-config ${args.hubConfigPath}`
    )
    return
  }

  const { lanes } = buildAdapterAndLanes(cfg, args.stateDir)

  console.error(`autopilotd: preflight OK — ${lanes.length} lane${lanes.length === 1 ? '' : 's'}, SDK resolved`)

  if (!args.hold) {
    process.exit(0)
    return
  }

  fs.writeFileSync(args.readyFile, '')
  // A bare SIGTERM/SIGINT listener does not keep the event loop alive on its own (nothing else
  // is running once preflight construction finishes) — an unref'd-never interval is the
  // standing keep-alive handle; teardown clears it before exiting.
  const keepAlive = setInterval(() => {}, 1 << 30)
  let tearingDown = false
  function teardown(signal) {
    if (tearingDown) return
    tearingDown = true
    console.error(`autopilotd: ${signal} received — ending preflight hold`)
    clearInterval(keepAlive)
    try {
      fs.unlinkSync(args.readyFile)
    } catch {
      // already gone — nothing left to clean up
    }
    process.exit(0)
  }
  process.on('SIGTERM', () => teardown('SIGTERM'))
  process.on('SIGINT', () => teardown('SIGINT'))
}

// D8: SIGTERM/SIGINT stop every lane (which aborts its in-flight session, cancels any pending
// ask, kills dev-server/tunnel process groups, and persists lane state — all inside
// lane.stop()), then stop the adapter's poll loop, then release the pidfile lock (D5 — "removed
// on clean shutdown"), then exit 0. A second signal during shutdown forces an immediate exit
// rather than waiting out a stuck lane — the lock is deliberately left in place on that path;
// daemon/lock.js's stale-pid recovery is what cleans it up on the next start.
function installSignalHandlers(adapter, lanes, stateDir) {
  let shuttingDown = false
  async function shutdown(signal) {
    if (shuttingDown) {
      console.error(`autopilotd: second ${signal} received — forcing exit`)
      process.exit(1)
    }
    shuttingDown = true
    console.error(`autopilotd: ${signal} received — stopping lanes`)
    await Promise.all(lanes.map((lane) => lane.stop()))
    await adapter.stop()
    releaseLock({ stateDir, pid: process.pid })
    process.exit(0)
  }
  process.on('SIGTERM', () => shutdown('SIGTERM'))
  process.on('SIGINT', () => shutdown('SIGINT'))
}

async function main() {
  assertNoRecursion()
  assertNodeVersion()

  const args = parseArgs(process.argv.slice(2))

  let cfg
  try {
    cfg = loadHubConfig({ hubConfigPath: args.hubConfigPath, overridesPath: args.overridesPath })
  } catch (err) {
    fail(err.message)
    return
  }

  if (args.check) {
    runPreflight(cfg, args)
    return
  }

  // D7: registrations refreshed on every real start (never inside --check's offline path) — a
  // box that cannot register must say so loudly, not run half-routed (Behavior § Boot order).
  try {
    await registerRepos({
      hubUrl: cfg.credential.hubUrl,
      token: cfg.credential.token,
      repos: cfg.lanes.map((lane) => ({ name: lane.project, root: lane.root })),
    })
  } catch (err) {
    console.error(err.message)
    process.exit(1)
    return
  }

  // D5 Lock lifecycle order (pinned): mkdirSync(stateDir) — the lock lives inside it — THEN
  // acquireLock, both BEFORE any adapter/lane construction. --check never reaches this branch,
  // so preflight always runs beside a live daemon without touching the lock.
  fs.mkdirSync(args.stateDir, { recursive: true })

  try {
    acquireLock({ stateDir: args.stateDir, pid: process.pid })
  } catch (err) {
    if (err instanceof LockError) {
      fail(err.message)
      return
    }
    throw err
  }

  const { adapter, lanes } = buildAdapterAndLanes(cfg, args.stateDir)

  adapter.start()
  for (const lane of lanes) lane.start()
  installSignalHandlers(adapter, lanes, args.stateDir)
}

main()
