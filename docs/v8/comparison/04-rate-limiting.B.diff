diff --git a/src/rate-limit.js b/src/rate-limit.js
new file mode 100644
index 0000000..c96858a
--- /dev/null
+++ b/src/rate-limit.js
@@ -0,0 +1,38 @@
+'use strict'
+
+const IDLE_MS = 600000
+
+function createRateLimiter({ capacity, refillPerSec, now = Date.now } = {}) {
+  if (!Number.isInteger(capacity) || capacity <= 0) {
+    throw new TypeError('rateLimit.capacity must be a positive integer')
+  }
+  if (typeof refillPerSec !== 'number' || !(refillPerSec > 0) || !Number.isFinite(refillPerSec)) {
+    throw new TypeError('rateLimit.refillPerSec must be a positive number')
+  }
+  const buckets = new Map()
+
+  function take(ip) {
+    const t = now()
+    for (const [key, b] of buckets) {
+      if (t - b.last >= IDLE_MS) buckets.delete(key)
+    }
+    let b = buckets.get(ip)
+    if (!b) {
+      b = { tokens: capacity, last: t }
+      buckets.set(ip, b)
+    } else {
+      b.tokens = Math.min(capacity, b.tokens + ((t - b.last) / 1000) * refillPerSec)
+      b.last = t
+    }
+    if (b.tokens >= 1) {
+      b.tokens -= 1
+      return { allowed: true, remaining: Math.floor(b.tokens) }
+    }
+    const retryAfter = Math.max(1, Math.ceil((1 - b.tokens) / refillPerSec))
+    return { allowed: false, remaining: 0, retryAfter }
+  }
+
+  return { take, size: () => buckets.size }
+}
+
+module.exports = { createRateLimiter }
