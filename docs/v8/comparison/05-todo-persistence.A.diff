diff --git a/src/store.js b/src/store.js
new file mode 100644
index 0000000..f57a2fd
--- /dev/null
+++ b/src/store.js
@@ -0,0 +1,38 @@
+'use strict'
+const fs = require('node:fs')
+const path = require('node:path')
+
+const isObject = (v) => typeof v === 'object' && v !== null && !Array.isArray(v)
+
+function validDoc(doc) {
+  if (!isObject(doc)) return false
+  const t = doc.todos
+  if (t === undefined) return true
+  return isObject(t) && Array.isArray(t.items) && Number.isInteger(t.nextId) && t.nextId > 0
+}
+
+function createStore({ file = 'data/todos.json', logger } = {}) {
+  const abs = path.resolve(process.cwd(), file)
+  let doc = {}
+  let raw = null
+  try { raw = fs.readFileSync(abs, 'utf8') } catch (e) { if (e.code !== 'ENOENT') raw = '' }
+  if (raw !== null) {
+    let parsed
+    try { parsed = JSON.parse(raw) } catch { parsed = undefined }
+    if (validDoc(parsed)) doc = parsed
+    else logger.warn(`store: corrupt file ${abs}, starting empty`)
+  }
+
+  return {
+    file: abs,
+    read(section) { return doc[section] },
+    write(section, value) {
+      doc = { ...doc, [section]: value }
+      fs.mkdirSync(path.dirname(abs), { recursive: true })
+      fs.writeFileSync(abs + '.tmp', JSON.stringify(doc, null, 2))
+      fs.renameSync(abs + '.tmp', abs)
+    },
+  }
+}
+
+module.exports = { createStore }
