diff --git a/src/store.js b/src/store.js
new file mode 100644
index 0000000..071a926
--- /dev/null
+++ b/src/store.js
@@ -0,0 +1,36 @@
+'use strict'
+const fs = require('node:fs')
+const path = require('node:path')
+
+const isObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v)
+
+function validTodos(t) {
+  return isObject(t) && Array.isArray(t.items) && Number.isInteger(t.nextId) && t.nextId > 0
+}
+
+function createStore({ file = 'data/todos.json', logger } = {}) {
+  const abs = path.resolve(process.cwd(), file)
+  let doc = {}
+
+  let raw
+  try { raw = fs.readFileSync(abs, 'utf8') } catch (e) { if (e.code !== 'ENOENT') throw e }
+  if (raw !== undefined) {
+    let parsed
+    try { parsed = JSON.parse(raw) } catch { parsed = undefined }
+    if (isObject(parsed) && (parsed.todos === undefined || validTodos(parsed.todos))) doc = parsed
+    else logger.warn(`store: corrupt file ${abs}, starting empty`)
+  }
+
+  return {
+    file: abs,
+    read: (section) => doc[section],
+    write(section, value) {
+      doc[section] = value
+      fs.mkdirSync(path.dirname(abs), { recursive: true })
+      fs.writeFileSync(abs + '.tmp', JSON.stringify(doc, null, 2))
+      fs.renameSync(abs + '.tmp', abs)
+    },
+  }
+}
+
+module.exports = { createStore }
