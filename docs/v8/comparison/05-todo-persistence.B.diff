diff --git a/tests/store.test.js b/tests/store.test.js
new file mode 100644
index 0000000..0ddcb37
--- /dev/null
+++ b/tests/store.test.js
@@ -0,0 +1,100 @@
+'use strict'
+const { test, beforeEach, afterEach, mock } = require('node:test')
+const assert = require('node:assert')
+const fs = require('node:fs')
+const os = require('node:os')
+const path = require('node:path')
+const { createApp } = require('../src/server')
+const { createLogger } = require('../src/logger')
+const { createStore } = require('../src/store')
+const todos = require('../src/todos')
+
+let dir
+beforeEach(() => { todos.reset(); dir = fs.mkdtempSync(path.join(os.tmpdir(), 'store-test-')) })
+afterEach(() => { mock.restoreAll(); fs.rmSync(dir, { recursive: true, force: true }) })
+
+async function withApp(file, fn) {
+  const lines = []
+  const server = createApp({ store: { file }, logger: createLogger((l) => lines.push(l)) })
+  await new Promise((r) => server.listen(0, r))
+  try { await fn(`http://localhost:${server.address().port}`, lines) } finally { await new Promise((r) => server.close(r)) }
+}
+const post = (title) => ({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title }) })
+
+test('AC-1: POST writes the todos section to the file', async () => {
+  const file = path.join(dir, 'todos.json')
+  await withApp(file, async (base) => {
+    assert.strictEqual((await fetch(`${base}/todos`, post('a'))).status, 201)
+    assert.deepStrictEqual(JSON.parse(fs.readFileSync(file, 'utf8')), { todos: { nextId: 2, items: [{ id: 1, title: 'a', done: false }] } })
+  })
+})
+
+test('AC-2: todos survive a restart and other sections are preserved', async () => {
+  const file = path.join(dir, 'todos.json')
+  await withApp(file, async (base) => { await fetch(`${base}/todos`, post('a')) })
+  todos.reset()
+  await withApp(file, async (base) => {
+    assert.deepStrictEqual(await (await fetch(`${base}/todos`)).json(), [{ id: 1, title: 'a', done: false }])
+    assert.strictEqual((await (await fetch(`${base}/todos`, post('b'))).json()).id, 2)
+  })
+  const seeded = path.join(dir, 'seeded.json')
+  fs.writeFileSync(seeded, JSON.stringify({ keys: { x: 1 }, todos: { nextId: 1, items: [] } }))
+  todos.reset()
+  await withApp(seeded, async (base) => { await fetch(`${base}/todos`, post('c')) })
+  assert.deepStrictEqual(JSON.parse(fs.readFileSync(seeded, 'utf8')).keys, { x: 1 })
+})
+
+test('AC-2: PATCH and DELETE write through; 404 and 400 do not', async () => {
+  const file = path.join(dir, 'todos.json')
+  await withApp(file, async (base) => {
+    await fetch(`${base}/todos`, post('a'))
+    await fetch(`${base}/todos/1`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: '{"done":true}' })
+    assert.strictEqual(JSON.parse(fs.readFileSync(file, 'utf8')).todos.items[0].done, true)
+    const spy = mock.method(fs, 'writeFileSync')
+    await fetch(`${base}/todos/99`, { method: 'DELETE' })
+    await fetch(`${base}/todos`, post(''))
+    assert.strictEqual(spy.mock.callCount(), 0)
+    await fetch(`${base}/todos/1`, { method: 'DELETE' })
+    assert.deepStrictEqual(JSON.parse(fs.readFileSync(file, 'utf8')).todos.items, [])
+  })
+})
+
+test('AC-3: write goes to <file>.tmp then renames, leaving no tmp file', async () => {
+  const file = path.join(dir, 'todos.json')
+  const order = []
+  const w = fs.writeFileSync
+  const r = fs.renameSync
+  mock.method(fs, 'writeFileSync', (...a) => { order.push(['write', a[0]]); return w(...a) })
+  mock.method(fs, 'renameSync', (...a) => { order.push(['rename', a[0], a[1]]); return r(...a) })
+  await withApp(file, async (base) => { await fetch(`${base}/todos`, post('a')) })
+  assert.deepStrictEqual(order, [['write', `${file}.tmp`], ['rename', `${file}.tmp`, file]])
+  assert.deepStrictEqual(fs.readdirSync(dir), ['todos.json'])
+})
+
+test('AC-4: a missing file starts empty, warns nothing, and is created on first write', async () => {
+  const file = path.join(dir, 'a', 'b', 'todos.json')
+  await withApp(file, async (base, lines) => {
+    assert.deepStrictEqual(await (await fetch(`${base}/todos`)).json(), [])
+    assert.ok(!lines.some((l) => l.startsWith('WARN')))
+    assert.strictEqual(fs.existsSync(file), false)
+    await fetch(`${base}/todos`, post('a'))
+    assert.strictEqual(fs.existsSync(file), true)
+  })
+})
+
+for (const content of ['{not json', '[]', '{"todos":{"nextId":"x","items":[]}}']) {
+  test(`AC-5: corrupt file ${content} starts empty with one warning`, async () => {
+    const file = path.join(dir, 'todos.json')
+    fs.writeFileSync(file, content)
+    await withApp(file, async (base, lines) => {
+      assert.deepStrictEqual(await (await fetch(`${base}/todos`)).json(), [])
+      assert.deepStrictEqual(lines.filter((l) => l.startsWith('WARN')), [`WARN store: corrupt file ${path.resolve(file)}, starting empty`])
+    })
+    assert.strictEqual(fs.readFileSync(file, 'utf8'), content)
+  })
+}
+
+test('AC-9: default file is data/todos.json under cwd', () => {
+  const store = createStore({ logger: createLogger(() => {}) })
+  assert.strictEqual(store.file, path.resolve(process.cwd(), 'data/todos.json'))
+})
diff --git a/tests/todos.test.js b/tests/todos.test.js
index 27676ca..f249b55 100644
--- a/tests/todos.test.js
+++ b/tests/todos.test.js
@@ -77,3 +77,38 @@ test('malformed percent-encoded id is 404 and the server keeps serving', async (
     assert.strictEqual((await fetch(`${base}/todos`)).status, 200)
   })
 })
+
+async function seed(base) {
+  for (const t of ['a', 'b', 'c']) await fetch(`${base}/todos`, json('POST', { title: t }))
+  await fetch(`${base}/todos/3`, json('PATCH', { done: true }))
+}
+
+test('GET /todos filters by done, paginates, and reports X-Total-Count', async () => {
+  await withServer(async (base) => {
+    await seed(base)
+    let res = await fetch(`${base}/todos?done=false&limit=1&offset=1`)
+    assert.deepStrictEqual(await res.json(), [{ id: 2, title: 'b', done: false }])
+    assert.strictEqual(res.headers.get('x-total-count'), '2')
+    res = await fetch(`${base}/todos?done=true`)
+    assert.deepStrictEqual(await res.json(), [{ id: 3, title: 'c', done: true }])
+    assert.strictEqual(res.headers.get('x-total-count'), '1')
+    res = await fetch(`${base}/todos?offset=5`)
+    assert.deepStrictEqual(await res.json(), [])
+    assert.strictEqual(res.headers.get('x-total-count'), '3')
+  })
+})
+
+test('GET /todos rejects invalid query and accepts limit=0', async () => {
+  await withServer(async (base) => {
+    await seed(base)
+    for (const q of ['done=yes', 'limit=-1', 'limit=abc', 'offset=1.5']) {
+      const res = await fetch(`${base}/todos?${q}`)
+      assert.strictEqual(res.status, 400, q)
+      assert.deepStrictEqual(await res.json(), { error: 'invalid query' })
+    }
+    const res = await fetch(`${base}/todos?limit=0`)
+    assert.strictEqual(res.status, 200)
+    assert.deepStrictEqual(await res.json(), [])
+    assert.strictEqual(res.headers.get('x-total-count'), '3')
+  })
+})
