index 0000000..21138e5
--- /dev/null
+++ b/src/auth.js
@@ -0,0 +1,19 @@
+'use strict'
+const keys = require('./keys')
+
+const unauthorized = () => ({ status: 401, body: { error: 'unauthorized' } })
+
+function authenticate(req) {
+  const header = req.headers && req.headers.authorization
+  if (typeof header !== 'string') return null
+  const m = /^bearer (.+)$/i.exec(header)
+  if (!m) return null
+  return keys.findByKey(m[1])
+}
+
+const requireKey = (req) => (authenticate(req) ? null : unauthorized())
+
+// POST /keys is open only while no key exists.
+const bootstrapGuard = (req) => (keys.count() === 0 ? null : requireKey(req))
+
+module.exports = { authenticate, requireKey, bootstrapGuard }
diff --git a/src/keys.js b/src/keys.js
new file mode 100644
index 0000000..713a467
--- /dev/null
+++ b/src/keys.js
@@ -0,0 +1,50 @@
+'use strict'
+const crypto = require('node:crypto')
+
+let items = []
+let nextId = 1
+let store = null
+
+const hashOf = (key) => crypto.createHash('sha256').update(key).digest('hex')
+
+function reset() { items = []; nextId = 1; store = null }
+
+function attach(s) {
+  store = s
+  const section = s.read('keys')
+  items = section ? section.items : []
+  nextId = section ? section.nextId : 1
+}
+
+const persist = () => { if (store) store.write('keys', { nextId, items }) }
+
+const notFound = () => ({ status: 404, body: { error: 'not found' } })
+
+function create(req) {
+  const name = req.body && req.body.name
+  if (typeof name !== 'string' || !name) return { status: 400, body: { error: 'name required' } }
+  const key = 'tk_' + crypto.randomBytes(16).toString('hex')
+  const record = { id: nextId++, name, hash: hashOf(key) }
+  items.push(record)
+  persist()
+  return { status: 201, body: { id: record.id, name, key } }
+}
+
+function list() {
+  return { status: 200, body: items.map(({ id, name }) => ({ id, name })) }
+}
+
+function remove(req) {
+  const record = items.find((k) => k.id === Number(req.params.id))
+  if (!record) return notFound()
+  items.splice(items.indexOf(record), 1)
+  persist()
+  return { status: 204, body: null }
+}
+
+const findByKey = (key) => {
+  const hash = hashOf(key)
+  return items.find((k) => k.hash === hash) || null
+}
+
+module.exports = { create, list, remove, reset, attach, findByKey, count: () => items.length }
