@@ -0,0 +1,14 @@
+'use strict'
+const keys = require('./keys')
+
+const unauthorized = () => ({ status: 401, body: { error: 'unauthorized' } })
+
+function authenticate(req) {
+  const m = /^bearer ([^ ].*)$/i.exec(req.headers.authorization || '')
+  return m ? keys.findByHash(keys.hashOf(m[1])) : null
+}
+
+const requireKey = (req) => (authenticate(req) ? null : unauthorized())
+const bootstrapGuard = (req) => (keys.count() === 0 || authenticate(req) ? null : unauthorized())
+
+module.exports = { authenticate, requireKey, bootstrapGuard }
diff --git a/src/keys.js b/src/keys.js
new file mode 100644
index 0000000..a57f667
--- /dev/null
+++ b/src/keys.js
@@ -0,0 +1,46 @@
+'use strict'
+const crypto = require('node:crypto')
+
+let keys = []
+let nextId = 1
+let store = null
+
+const hashOf = (key) => crypto.createHash('sha256').update(key).digest('hex')
+
+function reset() { keys = []; nextId = 1; store = null }
+
+function attach(s) {
+  store = s
+  const saved = s.read('keys')
+  keys = saved ? saved.items : []
+  nextId = saved ? saved.nextId : 1
+}
+
+const persist = () => { if (store) store.write('keys', { nextId, items: keys }) }
+
+function create(req) {
+  const name = req.body && req.body.name
+  if (typeof name !== 'string' || !name) return { status: 400, body: { error: 'name required' } }
+  const key = 'tk_' + crypto.randomBytes(16).toString('hex')
+  const record = { id: nextId++, name, hash: hashOf(key) }
+  keys.push(record)
+  persist()
+  return { status: 201, body: { id: record.id, name, key } }
+}
+
+function list() {
+  return { status: 200, body: keys.map(({ id, name }) => ({ id, name })) }
+}
+
+function remove(req) {
+  const i = keys.findIndex((k) => k.id === Number(req.params.id))
+  if (i < 0) return { status: 404, body: { error: 'not found' } }
+  keys.splice(i, 1)
+  persist()
+  return { status: 204, body: null }
+}
+
+const findByHash = (hash) => keys.find((k) => k.hash === hash) || null
+const count = () => keys.length
+
+module.exports = { create, list, remove, attach, reset, hashOf, findByHash, count }
