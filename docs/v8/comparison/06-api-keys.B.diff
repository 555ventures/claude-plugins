diff --git a/tests/keys.test.js b/tests/keys.test.js
new file mode 100644
index 0000000..d5862df
--- /dev/null
+++ b/tests/keys.test.js
@@ -0,0 +1,121 @@
+'use strict'
+const { test, beforeEach, afterEach } = require('node:test')
+const assert = require('node:assert')
+const crypto = require('node:crypto')
+const fs = require('node:fs')
+const os = require('node:os')
+const path = require('node:path')
+const { createApp } = require('../src/server')
+const todos = require('../src/todos')
+const keys = require('../src/keys')
+
+let dir
+beforeEach(() => { todos.reset(); keys.reset(); dir = fs.mkdtempSync(path.join(os.tmpdir(), 'keys-test-')) })
+afterEach(() => fs.rmSync(dir, { recursive: true, force: true }))
+
+async function withServer(fn, opts) {
+  const server = createApp(opts)
+  await new Promise((r) => server.listen(0, r))
+  try { await fn(`http://localhost:${server.address().port}`) } finally { await new Promise((r) => server.close(r)) }
+}
+const send = (method, body, key) => ({
+  method,
+  headers: { 'content-type': 'application/json', ...(key ? { authorization: `Bearer ${key}` } : {}) },
+  body: body === undefined ? undefined : JSON.stringify(body),
+})
+const mint = async (base, name, key) => (await fetch(`${base}/keys`, send('POST', { name }, key))).json()
+const UNAUTH = { error: 'unauthorized' }
+
+test('AC-1: first key is created without credentials', async () => {
+  await withServer(async (base) => {
+    const res = await fetch(`${base}/keys`, send('POST', { name: 'ci' }))
+    assert.strictEqual(res.status, 201)
+    const body = await res.json()
+    assert.strictEqual(body.id, 1)
+    assert.strictEqual(body.name, 'ci')
+    assert.match(body.key, /^tk_[0-9a-f]{32}$/)
+  })
+})
+
+test('AC-2: second key needs a valid key', async () => {
+  await withServer(async (base) => {
+    const first = await mint(base, 'ci')
+    const res = await fetch(`${base}/keys`, send('POST', { name: 'b' }))
+    assert.strictEqual(res.status, 401)
+    assert.deepStrictEqual(await res.json(), UNAUTH)
+    const ok = await fetch(`${base}/keys`, send('POST', { name: 'b' }, first.key))
+    assert.strictEqual(ok.status, 201)
+    assert.strictEqual((await ok.json()).id, 2)
+  })
+})
+
+test('AC-3: GET /keys lists id and name only', async () => {
+  await withServer(async (base) => {
+    const first = await mint(base, 'ci')
+    await mint(base, 'b', first.key)
+    const res = await fetch(`${base}/keys`, send('GET', undefined, first.key))
+    assert.strictEqual(res.status, 200)
+    assert.deepStrictEqual(await res.json(), [{ id: 1, name: 'ci' }, { id: 2, name: 'b' }])
+    assert.strictEqual((await fetch(`${base}/keys`)).status, 401)
+  })
+})
+
+test('AC-4: DELETE revokes, unknown id is 404, empty name is 400', async () => {
+  await withServer(async (base) => {
+    const k1 = await mint(base, 'ci')
+    const k2 = await mint(base, 'b', k1.key)
+    const del = await fetch(`${base}/keys/1`, send('DELETE', undefined, k2.key))
+    assert.strictEqual(del.status, 204)
+    assert.strictEqual(await del.text(), '')
+    assert.strictEqual((await fetch(`${base}/todos`, send('GET', undefined, k1.key))).status, 401)
+    const nf = await fetch(`${base}/keys/99`, send('DELETE', undefined, k2.key))
+    assert.strictEqual(nf.status, 404)
+    assert.deepStrictEqual(await nf.json(), { error: 'not found' })
+    const bad = await fetch(`${base}/keys`, send('POST', {}, k2.key))
+    assert.strictEqual(bad.status, 400)
+    assert.deepStrictEqual(await bad.json(), { error: 'name required' })
+  })
+})
+
+test('AC-5: scheme is case-insensitive; wrong, malformed or missing credentials are 401', async () => {
+  await withServer(async (base) => {
+    const { key } = await mint(base, 'ci')
+    const get = (headers) => fetch(`${base}/todos`, { headers })
+    assert.strictEqual((await get({ authorization: `bearer ${key}` })).status, 200)
+    for (const headers of [
+      { authorization: 'Bearer tk_00000000000000000000000000000000' },
+      { authorization: 'Basic Y2k6eA==' },
+      { authorization: 'Bearer' },
+      {},
+    ]) {
+      const res = await get(headers)
+      assert.strictEqual(res.status, 401, JSON.stringify(headers))
+      assert.deepStrictEqual(await res.json(), UNAUTH)
+    }
+  })
+})
+
+test('AC-7: deleting the last key reopens POST /keys', async () => {
+  await withServer(async (base) => {
+    const { key } = await mint(base, 'ci')
+    assert.strictEqual((await fetch(`${base}/keys/1`, send('DELETE', undefined, key))).status, 204)
+    const res = await fetch(`${base}/keys`, send('POST', { name: 'new' }))
+    assert.strictEqual(res.status, 201)
+  })
+})
+
+test('AC-9: keys persist as hashes in the store file, never the raw key', async () => {
+  const file = path.join(dir, 'todos.json')
+  let key
+  await withServer(async (base) => { key = (await mint(base, 'ci')).key }, { store: { file } })
+  const text = fs.readFileSync(file, 'utf8')
+  assert.deepStrictEqual(JSON.parse(text).keys, {
+    nextId: 2,
+    items: [{ id: 1, name: 'ci', hash: crypto.createHash('sha256').update(key).digest('hex') }],
+  })
+  assert.ok(!text.includes(key))
+  todos.reset(); keys.reset()
+  await withServer(async (base) => {
+    assert.strictEqual((await fetch(`${base}/todos`, send('GET', undefined, key))).status, 200)
+  }, { store: { file } })
+})
