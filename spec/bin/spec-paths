#!/usr/bin/env bash
# Print absolute paths to assets bundled in the spec plugin.
#
# Command markdown bodies cannot use ${CLAUDE_PLUGIN_ROOT} (it is only substituted
# in hooks.json, MCP/LSP configs, and frontmatter). This script is on $PATH during
# sessions because it lives in the plugin's bin/ — commands run `spec-paths <key>`
# once and use the absolute path it prints (e.g. for Workflow({scriptPath})).
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

case "${1:-root}" in
  root)        echo "$ROOT" ;;
  workflows)   echo "$ROOT/workflows" ;;
  wf-design)   echo "$ROOT/workflows/wf-design.js" ;;
  wf-enforce)  echo "$ROOT/workflows/wf-enforce.js" ;;
  wf-panel)    echo "$ROOT/workflows/wf-panel.js" ;;
  wf-research) echo "$ROOT/workflows/wf-research.js" ;;
  dc-extract)  echo "$ROOT/scripts/dc-extract.js" ;;
  design-atlas) echo "$ROOT/scripts/design-atlas.js" ;;
  design-driver) echo "$ROOT/scripts/spec-design-driver.js" ;;
  skeletons-check) echo "$ROOT/scripts/skeletons-check.js" ;;
  fidelity-check) echo "$ROOT/scripts/fidelity-check.js" ;;
  components-check) echo "$ROOT/scripts/components-check.js" ;;
  merge-back)  echo "$ROOT/scripts/merge-back.sh" ;;
  smoke)       echo "$ROOT/scripts/smoke.sh" ;;
  manifest-check) echo "$ROOT/scripts/manifest-check.sh" ;;
  env-preflight)  echo "$ROOT/scripts/env-preflight.js" ;;
  citations-check) echo "$ROOT/scripts/citations-check.js" ;;
  review-legs)    echo "$ROOT/scripts/review-legs.js" ;;
  review-driver)  echo "$ROOT/scripts/spec-review-driver.js" ;;
  report-render)  echo "$ROOT/scripts/report-render.js" ;;
  spec-status)    echo "$ROOT/scripts/spec-status.js" ;;
  scope-reconcile) echo "$ROOT/scripts/scope-reconcile.js" ;;
  verdict)        echo "$ROOT/scripts/verdict.js" ;;
  ac-matrix)      echo "$ROOT/scripts/ac-matrix.js" ;;
  promise-sweep)  echo "$ROOT/scripts/promise-sweep.js" ;;
  collision-closure) echo "$ROOT/scripts/collision-closure.js" ;;
  ci-query)       echo "$ROOT/scripts/ci-query.js" ;;
  ci-gate-parity) echo "$ROOT/scripts/ci-gate-parity.js" ;;
  replay)         echo "$ROOT/scripts/replay.js" ;;
  fleet-reader)   echo "$ROOT/scripts/fleet-reader.js" ;;
  shared)         echo "$ROOT/doctrine/core.md" ;;
  shared-design)  echo "$ROOT/doctrine/design.md" ;;
  shared-genesis) echo "$ROOT/doctrine/genesis.md" ;;
  replay-corpus)  echo "$ROOT/doctrine/replay-corpus.md" ;;
  shared-for)
    # Print the shared-invariants CONTENT scoped to one command — only the `## ` sections that
    # command consumes, so a session never pays for doctrine it cannot act on. Sections are
    # drawn from core.md and (for design-family commands) design.md; section names must match
    # the headings exactly (prefix match tolerates parentheticals); an unknown command falls
    # back to both full documents (fail-open, never less doctrine than intended). Question
    # Style + Console Output Style ride on every list: every command asks questions and reports.
    CMD="${2:-}"
    CORE="$ROOT/doctrine/core.md"
    DESIGN="$ROOT/doctrine/design.md"
    case "$CMD" in
      plan)    SECTIONS="Host Grounding|Pipeline Entry|Tiers|Decomposition|State Machine|Model Placement|Decisions|Question Style|Console Output Style|MCP Policy|Canonical Docs Loop" ;;
      design)  SECTIONS="Host Grounding|State Machine|Design Canon|Design Authoring Contracts|Design Binding Pipeline|Design Atlas|Model Placement|Decisions|Question Style|Console Output Style|Workflows Encode Shape, Not Judgment|Worker Git Ban|Read-Only Surfaces|MCP Policy" ;;
      atlas)   SECTIONS="Host Grounding|Design Canon|Design Atlas|Model Placement|Decisions|Question Style|Console Output Style" ;;
      sketch)  SECTIONS="Host Grounding|State Machine|Design Canon|Design Atlas|Model Placement|Decisions|Question Style|Console Output Style" ;;
      build)   SECTIONS="Host Grounding|Tiers|State Machine|Model Placement|Incident Policy|Decisions|Question Style|Console Output Style|Worker Git Ban|Read-Only Surfaces|MCP Policy|On-Disk Handoff" ;;
      review)  SECTIONS="Host Grounding|Tiers|State Machine|Runtime Verification|Model Placement|Incident Policy|Decisions|Question Style|Console Output Style|Worker Git Ban|Read-Only Surfaces|Canonical Docs Loop" ;;
      release) SECTIONS="Host Grounding|Runtime Verification|Release Stage|Feedback Loop|Model Placement|Decisions|Question Style|Console Output Style|Canonical Docs Loop" ;;
      enforce) SECTIONS="Host Grounding|Grounding Drift|Rule Enforcement|Model Placement|Question Style|Console Output Style|Workflows Encode Shape, Not Judgment" ;;
      genesis-architect) SECTIONS="Host Grounding|Pipeline Entry|Design Atlas|Model Placement|Decisions|Question Style|Console Output Style|Workflows Encode Shape, Not Judgment|Worker Git Ban|MCP Policy" ;;
      genesis-explore)   SECTIONS="Design Canon|Design Atlas|Model Placement|Decisions|Question Style|Console Output Style|Workflows Encode Shape, Not Judgment|Worker Git Ban" ;;
      genesis-design)    SECTIONS="Design Canon|Design Authoring Contracts|Model Placement|Decisions|Question Style|Console Output Style|Workflows Encode Shape, Not Judgment" ;;
      status)  SECTIONS="Host Grounding|State Machine|Question Style|Console Output Style" ;;
      escape)  SECTIONS="Host Grounding|Feedback Loop|Incident Policy|Question Style|Console Output Style" ;;
      doctor)  SECTIONS="Host Grounding|Grounding Drift|Rule Enforcement|Runtime Verification|Feedback Loop|Tiers|State Machine|Question Style|Console Output Style" ;;
      replay)  SECTIONS="Host Grounding|Tiers|Model Placement|Decisions|Question Style|Console Output Style|Feedback Loop" ;;
      *) cat "$CORE" "$DESIGN"; exit 0 ;;
    esac
    echo "<!-- shared invariants scoped to /spec:${CMD} — full doctrine: $CORE + $DESIGN -->"
    # Prefix match on the heading (some headings carry a parenthetical suffix). keep resets at
    # each file boundary so the second file's frontmatter never rides a kept tail section.
    awk -v re="^## (${SECTIONS})" '
      FNR == 1 { keep = 0 }
      FNR <= 4 && NR <= 4 { print; next }
      /^## / { keep = ($0 ~ re) }
      keep { print }
    ' "$CORE" "$DESIGN"
    ;;
  template)    echo "$ROOT/templates/spec.md" ;;
  feedback-template) echo "$ROOT/templates/feedback-brief.md" ;;
  templates)   echo "$ROOT/templates" ;;
  version)     jq -r '.version // empty' "$ROOT/.claude-plugin/plugin.json" ;;
  contract)    echo "$ROOT/templates/grounding-contract.md" ;;
  contract-hash)
    if command -v sha256sum >/dev/null 2>&1; then
      sha256sum "$ROOT/templates/grounding-contract.md" | cut -c1-12
    else
      shasum -a 256 "$ROOT/templates/grounding-contract.md" | cut -c1-12
    fi
    ;;
  *)
    echo "usage: spec-paths [root|workflows|wf-design|wf-enforce|wf-panel|wf-research|dc-extract|design-atlas|design-driver|skeletons-check|fidelity-check|components-check|merge-back|smoke|manifest-check|env-preflight|citations-check|review-legs|review-driver|report-render|spec-status|scope-reconcile|verdict|ac-matrix|promise-sweep|collision-closure|ci-query|ci-gate-parity|replay|fleet-reader|shared|shared-design|shared-for <command>|shared-genesis|replay-corpus|template|templates|feedback-template|version|contract|contract-hash]" >&2
    exit 1
    ;;
esac
